{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "crime_scene_search config",
  "description": "Осмотр места: игрок тапает по подозрительным местам фона; обязательные hotspot'ы = улики.",
  "type": "object", "additionalProperties": false,
  "required": ["scene_bg", "hotspots", "max_misses"],
  "properties": {
    "scene_bg": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "hotspots": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rect", "label_key", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "rect": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 }, "description": "[x, y, w, h] в долях экрана" },
          "label_key": { "type": "string" },
          "required": { "type": "boolean" },
          "zoom_asset": { "type": "string" }
        }
      }
    },
    "max_misses": { "type": "integer", "minimum": 1, "maximum": 20 },
    "time_limit_ms": { "type": "integer", "minimum": 0 },
    "hint_after_misses": { "type": "integer", "minimum": 0 }
  }
}
