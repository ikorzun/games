{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ikorzun/games/schemas/episode.schema.json",
  "title": "Episode",
  "description": "Описание одного эпизода визуальной новеллы «Криминальная Россия». Эпизод = метаданные дела + граф блоков (нарративные функции) + сцены (единицы показа) + мини-игры + концовки. Весь текст — ключи локализации (locales/<lang>/<episode_id>.json). Файл не зависит от движка: из него собирается Ren'Py-скрипт или JSON для веб-рантайма.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "season", "order", "title_key", "archetype", "based_on", "frame", "cast", "variables", "blocks", "scenes", "endings", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/asciiId", "description": "Напр. ep01_murylev. Только латиница — требование веб-платформ." },
    "season": { "type": "integer", "minimum": 1 },
    "order": { "type": "integer", "minimum": 1, "description": "Порядок в сезоне." },
    "title_key": { "$ref": "#/$defs/locKey" },
    "logline_key": { "$ref": "#/$defs/locKey" },
    "archetype": { "$ref": "#/$defs/archetype" },
    "template": { "type": "string", "description": "Имя шаблона блоков из docs/architecture/02-narrative-blocks.md, напр. serial_killer_v1. Эпизод может переопределять порядок блоков." },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_name", "years", "city", "fictionalization"],
      "properties": {
        "case_name": { "type": "string", "description": "Реальное дело / название выпуска передачи (служебное, не показывается)." },
        "tv_episode": { "type": "string", "description": "Название выпуска «Криминальной России», если есть." },
        "years": { "type": "array", "items": { "type": "integer", "minimum": 1960, "maximum": 2030 }, "minItems": 1, "maxItems": 2 },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "fictionalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "names_changed"],
          "properties": {
            "level": { "type": "string", "enum": ["documentary", "dramatized", "inspired"], "description": "documentary — реальные имена/факты; dramatized — реальная канва, вымышленные детали и диалоги; inspired — по мотивам, имена и география изменены." },
            "names_changed": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pov", "narrator"],
      "properties": {
        "pov": { "type": "string", "enum": ["investigator", "journalist", "editor", "witness", "viewer"], "description": "Через кого играет игрок в слое реконструкции (investigator/journalist/witness) или в слое редакции (editor). Значение criminal намеренно отсутствует: преступник неиграбелен." },
        "editorial_layer": { "type": "boolean", "default": true, "description": "Есть ли в эпизоде слой «редакция передачи» (настоящее время): блоки editorial, мини-игра broadcast_edit." },
        "narrator": { "type": "string", "enum": ["voiceover", "none"], "description": "voiceover — закадровый рассказчик в стиле передачи." },
        "player_character": { "$ref": "#/$defs/asciiId" }
      }
    },
    "content_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["violence", "murder", "sexual_violence_implied", "child_victims", "suicide", "drugs", "torture_implied", "animal_harm", "gore_implied", "strong_language"] }
    },
    "age_rating": { "type": "string", "enum": ["16+", "18+"], "default": "18+" },
    "estimated_minutes": { "type": "integer", "minimum": 10, "maximum": 180 },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_lang": { "const": "ru" },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ru": { "$ref": "#/$defs/locStatus" },
            "en": { "$ref": "#/$defs/locStatus" },
            "es": { "$ref": "#/$defs/locStatus" },
            "pt": { "$ref": "#/$defs/locStatus" }
          }
        },
        "glossary": { "type": "string", "description": "Путь к глоссарию реалий эпизода (docs/localization/glossary-<ep>.md)." }
      }
    },
    "cast": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    },
    "variables": {
      "type": "object",
      "description": "Переменные состояния эпизода. Имена — ascii. Глобальные (между эпизодами) помечаются scope: global.",
      "additionalProperties": { "$ref": "#/$defs/variable" }
    },
    "blocks": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/block" }
    },
    "scenes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/scene" }
    },
    "minigames": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/minigame" }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ending" }
    },
    "archive_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/archiveItem" }
    },
    "assets": { "$ref": "#/$defs/assets" }
  },

  "$defs": {
    "asciiId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "locKey": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$", "description": "Ключ локализации, напр. ep01.s03.l012 или ui.menu.save." },
    "locStatus": { "type": "string", "enum": ["source", "none", "machine", "draft", "edited", "lqa", "final"] },
    "expr": {
      "type": "string",
      "description": "Условие. Мини-грамматика: переменные, числа, true/false, строки в одинарных кавычках; операторы == != < <= > >= && || ! ( ). Пример: trust_opera >= 2 && !found_knife",
      "maxLength": 300
    },

    "archetype": {
      "type": "string",
      "enum": [
        "serial_killer",
        "gang_war",
        "contract_killing",
        "fraud",
        "real_estate_murders",
        "kidnapping_hostages",
        "robbery_cash",
        "corrupt_police",
        "cult",
        "cannibal",
        "family_murder",
        "prison_escape",
        "terror_attack",
        "poisoning",
        "manhunt_fugitive"
      ]
    },

    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "name_key": { "$ref": "#/$defs/locKey" },
        "short_name_key": { "$ref": "#/$defs/locKey" },
        "role": { "type": "string", "enum": ["player", "investigator", "operative", "expert", "witness", "victim", "suspect", "criminal", "relative", "journalist", "official", "narrator", "extra"] },
        "real_person": { "type": "boolean", "default": false, "description": "true — реальное лицо (действуют правила фикционализации проекта)." },
        "sprite_set": { "$ref": "#/$defs/asciiId", "description": "Имя набора спрайтов в assets.sprites." },
        "voice": { "type": "string", "enum": ["none", "ru_only", "all"] },
        "name_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "bio_key": { "$ref": "#/$defs/locKey" }
      }
    },

    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "default"],
      "properties": {
        "type": { "type": "string", "enum": ["bool", "int", "string"] },
        "default": { "type": ["boolean", "integer", "string"] },
        "scope": { "type": "string", "enum": ["episode", "global"], "default": "episode" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "doc": { "type": "string" }
      }
    },

    "blockType": {
      "type": "string",
      "enum": [
        "cold_open",
        "title_card",
        "chronicle",
        "crime",
        "discovery",
        "investigation",
        "dead_end",
        "breakthrough",
        "pursuit",
        "confrontation",
        "trial",
        "epilogue",
        "interlude",
        "archive_break",
        "editorial"
      ],
      "description": "Нарративная функция блока. Описание и правила — docs/architecture/02-narrative-blocks.md."
    },

    "presentation": {
      "type": "string",
      "enum": ["reconstruction", "chronicle", "talking_head", "procedural", "title", "map", "courtroom", "montage", "document"],
      "description": "Визуальный режим показа блока (пресет камеры/фильтра/UI). См. docs/architecture/03-visual-language.md."
    },

    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "presentation", "entry_scene"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "type": { "$ref": "#/$defs/blockType" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "title_key": { "$ref": "#/$defs/locKey", "description": "Заголовок блока для карты прогресса / титра (напр. «Часть 2. Следствие»)." },
        "entry_scene": { "$ref": "#/$defs/asciiId" },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/asciiId" }, "description": "Сцены, принадлежащие блоку (для подгрузки ассетов и автосейва)." },
        "act": { "type": "integer", "minimum": 1, "maximum": 5 },
        "optional": { "type": "boolean", "default": false },
        "when": { "$ref": "#/$defs/expr", "description": "Блок включается, только если условие истинно (ветвление на уровне структуры)." },
        "ad_break_allowed": { "type": "boolean", "default": false, "description": "Можно ли показать interstitial ПЕРЕД этим блоком (только title_card, границы актов, epilogue)." },
        "autosave": { "type": "boolean", "default": true },
        "timeline": { "type": "string", "enum": ["crime", "investigation", "aftermath"], "description": "Какую временную линию показывает блок (двойная хронология)." },
        "season": { "type": "string", "enum": ["spring", "summer", "autumn", "winter"], "description": "Сезон блока: уличные фоны, CG и титры-даты его сцен должны ему соответствовать (линтер)." },
        "date_caption_key": { "$ref": "#/$defs/locKey", "description": "Титр даты/места в стиле передачи: «Тольятти, весна 1994»." },
        "music": { "$ref": "#/$defs/asciiId" }
      }
    },

    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "block", "stage", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "block": { "$ref": "#/$defs/asciiId" },
        "stage": { "$ref": "#/$defs/stage" },
        "music": { "$ref": "#/$defs/asciiId" },
        "ambient": { "$ref": "#/$defs/asciiId" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "notes": { "type": "string", "description": "Заметки сценариста/режиссёра, не попадают в сборку." }
      }
    },

    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg"],
      "properties": {
        "bg": { "$ref": "#/$defs/asciiId" },
        "filter": { "type": "string", "enum": ["none", "vhs", "vhs_heavy", "archive_photo", "night", "sepia", "desaturated", "noir"], "default": "none" },
        "time_of_day": { "type": "string", "enum": ["day", "evening", "night", "dawn"] },
        "weather": { "type": "string", "enum": ["clear", "rain", "snow", "fog"] },
        "season": { "type": "string", "enum": ["spring", "summer", "autumn", "winter"], "description": "Сезон сцены; по умолчанию — season блока. Линтер сверяет его с season фона/CG и с титром-датой." },
        "letterbox": { "type": "boolean", "default": false, "description": "Киношные полосы для реконструкций." }
      }
    },

    "position": { "type": "string", "enum": ["left", "center", "right", "offscreen_left", "offscreen_right"] },
    "transition": { "type": "string", "enum": ["cut", "fade", "dissolve", "wipe", "vhs_glitch", "flash", "slow_fade"] },

    "step": {
      "type": "object",
      "required": ["do"],
      "oneOf": [
        { "$ref": "#/$defs/stepSay" },
        { "$ref": "#/$defs/stepNarrate" },
        { "$ref": "#/$defs/stepCaption" },
        { "$ref": "#/$defs/stepShow" },
        { "$ref": "#/$defs/stepHide" },
        { "$ref": "#/$defs/stepBg" },
        { "$ref": "#/$defs/stepCg" },
        { "$ref": "#/$defs/stepDocument" },
        { "$ref": "#/$defs/stepAudio" },
        { "$ref": "#/$defs/stepFx" },
        { "$ref": "#/$defs/stepChoice" },
        { "$ref": "#/$defs/stepSet" },
        { "$ref": "#/$defs/stepBranch" },
        { "$ref": "#/$defs/stepJump" },
        { "$ref": "#/$defs/stepMinigame" },
        { "$ref": "#/$defs/stepArchive" },
        { "$ref": "#/$defs/stepEnd" }
      ]
    },

    "stepSay": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "who", "key"],
      "properties": {
        "do": { "const": "say" },
        "who": { "$ref": "#/$defs/asciiId" },
        "key": { "$ref": "#/$defs/locKey" },
        "expression": { "$ref": "#/$defs/asciiId", "description": "neutral, angry, scared, smirk… — из набора спрайтов персонажа." },
        "pose": { "$ref": "#/$defs/asciiId" },
        "position": { "$ref": "#/$defs/position" },
        "voice": { "$ref": "#/$defs/asciiId", "description": "id аудиофайла озвучки (если есть)." },
        "when": { "$ref": "#/$defs/expr" }
      }
    },
    "stepNarrate": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "key"],
      "properties": {
        "do": { "const": "narrate" },
        "key": { "$ref": "#/$defs/locKey" },
        "style": { "type": "string", "enum": ["voiceover", "inner", "report"], "default": "voiceover", "description": "voiceover — закадровый рассказчик; inner — мысли персонажа игрока; report — сухой протокольный текст." },
        "voice": { "$ref": "#/$defs/asciiId" },
        "when": { "$ref": "#/$defs/expr" }
      }
    },
    "stepCaption": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "key", "style"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "caption" },
        "key": { "$ref": "#/$defs/locKey" },
        "style": { "type": "string", "enum": ["date_stamp", "location", "lower_third", "chapter", "fact"], "description": "date_stamp — «Москва, октябрь 1993»; lower_third — подпись «говорящей головы»; chapter — титр части; fact — сухая справка." },
        "hold_ms": { "type": "integer", "minimum": 500, "maximum": 10000 }
      }
    },
    "stepShow": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "who"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "show" },
        "who": { "$ref": "#/$defs/asciiId" },
        "expression": { "$ref": "#/$defs/asciiId" },
        "pose": { "$ref": "#/$defs/asciiId" },
        "position": { "$ref": "#/$defs/position", "default": "center" },
        "transition": { "$ref": "#/$defs/transition", "default": "dissolve" },
        "silhouette": { "type": "boolean", "default": false, "description": "Показать как силуэт (неизвестный преступник до раскрытия)." }
      }
    },
    "stepHide": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "who"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "hide" },
        "who": { "$ref": "#/$defs/asciiId" },
        "transition": { "$ref": "#/$defs/transition", "default": "dissolve" }
      }
    },
    "stepBg": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "bg"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "bg" },
        "bg": { "$ref": "#/$defs/asciiId" },
        "filter": { "type": "string" },
        "transition": { "$ref": "#/$defs/transition", "default": "fade" }
      }
    },
    "stepCg": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "cg"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "cg" },
        "cg": { "$ref": "#/$defs/asciiId" },
        "transition": { "$ref": "#/$defs/transition", "default": "fade" },
        "hide_after": { "type": "boolean", "default": true }
      }
    },
    "stepDocument": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "doc"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "document" },
        "doc": { "$ref": "#/$defs/asciiId", "description": "id из assets.documents: протокол, ориентировка, фоторобот, справка, газетная вырезка." },
        "text_key": { "$ref": "#/$defs/locKey", "description": "Текст документа (локализуется отдельно от картинки — картинка без текста)." },
        "zoomable": { "type": "boolean", "default": true },
        "adds_to_archive": { "$ref": "#/$defs/asciiId" }
      }
    },
    "stepAudio": {
      "type": "object", "additionalProperties": false,
      "required": ["do"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "type": "string", "enum": ["music", "sfx", "ambient", "stop_music", "stop_ambient"] },
        "id": { "$ref": "#/$defs/asciiId" },
        "fade_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "loop": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stepFx": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "fx"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "fx" },
        "fx": { "type": "string", "enum": ["fade_out", "fade_in", "flash", "shake", "vhs_glitch", "tracking_noise", "freeze_frame", "zoom_in", "slow_motion", "black_hold", "static_tv", "rewind"] },
        "ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stepChoice": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "id", "options"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "choice" },
        "id": { "$ref": "#/$defs/asciiId" },
        "prompt_key": { "$ref": "#/$defs/locKey" },
        "kind": { "type": "string", "enum": ["investigative", "moral", "tactical", "dialogue", "cosmetic"], "description": "investigative — куда направить следствие; moral — нравственный выбор (влияет на концовку/персонажей); tactical — риск в операции; dialogue — тон; cosmetic — без последствий." },
        "timer_ms": { "type": "integer", "minimum": 3000, "maximum": 30000, "description": "Таймер только для tactical/dialogue; при истечении — default_option. Отключаем в настройках доступности." },
        "default_option": { "$ref": "#/$defs/asciiId" },
        "remember": { "type": "boolean", "default": true, "description": "Записать выбор в журнал решений (для эпилога)." },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "key", "goto"],
            "properties": {
              "id": { "$ref": "#/$defs/asciiId" },
              "key": { "$ref": "#/$defs/locKey" },
              "when": { "$ref": "#/$defs/expr" },
              "hidden_when_false": { "type": "boolean", "default": false, "description": "false — показать опцию неактивной (игрок видит, что что-то упустил)." },
              "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
              "goto": { "$ref": "#/$defs/asciiId" }
            }
          }
        }
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["var", "op"],
      "properties": {
        "var": { "$ref": "#/$defs/asciiId" },
        "op": { "type": "string", "enum": ["set", "add", "sub", "toggle"] },
        "value": { "type": ["boolean", "integer", "string"] }
      }
    },
    "stepSet": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "effects"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "set" },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "stepBranch": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "cases", "default"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "branch" },
        "cases": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["when", "goto"],
            "properties": { "when": { "$ref": "#/$defs/expr" }, "goto": { "$ref": "#/$defs/asciiId" } }
          }
        },
        "default": { "$ref": "#/$defs/asciiId" }
      }
    },
    "stepJump": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "scene"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "jump" },
        "scene": { "$ref": "#/$defs/asciiId" },
        "transition": { "$ref": "#/$defs/transition" }
      }
    },
    "stepMinigame": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "minigame"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "minigame" },
        "minigame": { "$ref": "#/$defs/asciiId" },
        "intro_key": { "$ref": "#/$defs/locKey", "description": "Короткий бриф перед мини-игрой (что нужно сделать)." }
      }
    },
    "stepArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "item"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "archive_unlock" },
        "item": { "$ref": "#/$defs/asciiId" },
        "toast": { "type": "boolean", "default": true }
      }
    },
    "stepEnd": {
      "type": "object", "additionalProperties": false,
      "required": ["do", "ending"],
      "properties": {
        "when": { "$ref": "#/$defs/expr", "description": "Условие показа шага; ложное — шаг пропускается." },
        "do": { "const": "end" },
        "ending": { "$ref": "#/$defs/asciiId" }
      }
    },

    "minigameType": {
      "type": "string",
      "enum": [
        "crime_scene_search",
        "evidence_board",
        "deduction_fill",
        "interrogation_press",
        "document_check",
        "identikit",
        "timeline",
        "wiretap",
        "database_search",
        "map_tracking",
        "stakeout_timing",
        "chase_qte",
        "lockpick",
        "card_game",
        "negotiation_timed",
        "forensic_match",
        "reconstruction",
        "broadcast_edit",
        "custom"
      ],
      "description": "Каталог паттернов — docs/architecture/04-minigames.md."
    },

    "minigame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title_key", "brief_key", "config", "outcomes", "skip"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "type": { "$ref": "#/$defs/minigameType" },
        "title_key": { "$ref": "#/$defs/locKey" },
        "brief_key": { "$ref": "#/$defs/locKey" },
        "beat": { "type": "string", "enum": ["crime_scene", "investigation", "interrogation", "deduction", "operation", "confrontation", "trial"], "description": "Какой сюжетный бит обслуживает." },
        "config": { "type": "object", "description": "Параметры, специфичные для типа (валидируются схемой типа в schemas/minigames/<type>.schema.json)." },
        "difficulty": { "type": "string", "enum": ["easy", "normal", "hard"], "default": "normal" },
        "time_limit_ms": { "type": "integer", "minimum": 0 },
        "skip": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed"],
          "properties": {
            "allowed": { "type": "boolean", "description": "Доступность: любую мини-игру можно пропустить (режим «только история»)." },
            "after_fails": { "type": "integer", "minimum": 0, "description": "Кнопка «пропустить» появляется после N неудач." },
            "skip_counts_as": { "type": "string", "enum": ["success", "partial", "fail"], "default": "partial" },
            "hint_rewarded_ad": { "type": "boolean", "default": false, "description": "Подсказку можно получить за rewarded-рекламу (веб-платформы)." }
          }
        },
        "outcomes": {
          "type": "object", "additionalProperties": false,
          "required": ["success", "fail"],
          "properties": {
            "success": { "$ref": "#/$defs/outcome" },
            "partial": { "$ref": "#/$defs/outcome" },
            "fail": { "$ref": "#/$defs/outcome" }
          }
        },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asciiId" } },
        "localized_assets": { "type": "array", "items": { "$ref": "#/$defs/asciiId" }, "description": "Ассеты с текстом внутри (документы, вывески) — по версии на язык." },
        "touch_ready": { "type": "boolean", "default": true },
        "notes": { "type": "string" }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["goto"],
      "properties": {
        "goto": { "$ref": "#/$defs/asciiId" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "archive_unlock": { "$ref": "#/$defs/asciiId" }
      }
    },

    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_key", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "title_key": { "$ref": "#/$defs/locKey" },
        "kind": { "type": "string", "enum": ["canonical", "variant", "early", "secret"], "description": "canonical — реальный исход дела; variant — тот же исход, другая судьба персонажей; early — провал следствия/досрочный финал; secret — архивная концовка." },
        "epilogue_scene": { "$ref": "#/$defs/asciiId" },
        "unlocks": { "type": "array", "items": { "$ref": "#/$defs/asciiId" } },
        "counts_toward_completion": { "type": "boolean", "default": true }
      }
    },

    "archiveItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title_key"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "kind": { "type": "string", "enum": ["document", "photo", "newspaper", "object", "map", "audio", "fact"] },
        "title_key": { "$ref": "#/$defs/locKey" },
        "text_key": { "$ref": "#/$defs/locKey" },
        "asset": { "$ref": "#/$defs/asciiId" },
        "real_fact": { "type": "boolean", "default": false, "description": "Пометка «так было на самом деле» в архиве." }
      }
    },

    "assetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "description": "Относительный путь; только латиница." },
        "license": { "type": "string" },
        "localized": { "type": "boolean", "default": false },
        "season": { "type": "string", "enum": ["spring", "summer", "autumn", "winter", "indoor", "any"], "description": "Для фонов и CG: сезон на картинке; indoor — интерьер, any — нейтральная картинка." },
        "notes": { "type": "string" }
      }
    },
    "spriteSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base", "expressions"],
      "properties": {
        "id": { "$ref": "#/$defs/asciiId" },
        "base": { "type": "string", "description": "Путь к базовому слою (тело/поза)." },
        "poses": { "type": "array", "items": { "$ref": "#/$defs/asciiId" } },
        "expressions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asciiId" } },
        "silhouette": { "type": "boolean", "default": false }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backgrounds": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "sprites": { "type": "array", "items": { "$ref": "#/$defs/spriteSet" } },
        "cg": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "music": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "sfx": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "ambient": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "voice": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
        "budget_mb": { "type": "number", "minimum": 1, "maximum": 300, "description": "Бюджет веса эпизода в сборке (веб: сумма эпизодов + ядро ≤ 300 МБ)." }
      }
    }
  }
}
