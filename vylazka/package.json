{
  "name": "vylazka",
  "version": "0.1.0",
  "private": true,
  "description": "«Вылазка» — хоррор-исследование от первого лица с бодикама: three.js, процедурные уровни, адаптеры платформ.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check_dist.mjs dist",
    "build:playgama": "vite build --mode playgama && node scripts/check_dist.mjs dist-playgama",
    "build:single": "node scripts/single_page.mjs dist dist-single/untitled_session.html",
    "preview": "vite preview",
    "preview:playgama": "vite preview --outDir dist-playgama --port 4176",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node e2e/smoke.mjs",
    "smoke:matrix": "node e2e/smoke.mjs --matrix"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playgama/bridge": "^2.4.2",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
