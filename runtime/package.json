{
  "name": "krimrussia-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-рантайм визуальной новеллы-антологии: интерпретатор эпизодов JSON, PixiJS-сцена, DOM-интерфейс, адаптеры платформ.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/pt-mono": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-sans-narrow": "^5.3.0",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
