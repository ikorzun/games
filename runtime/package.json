{
  "name": "krimrussia-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-рантайм визуальной новеллы-антологии: интерпретатор эпизодов JSON, PixiJS-сцена, DOM-интерфейс, адаптеры платформ.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check_dist.mjs dist",
    "build:playgama": "vite build --mode playgama && node scripts/check_dist.mjs dist-playgama",
    "preview": "vite preview",
    "preview:playgama": "vite preview --outDir dist-playgama --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node e2e/smoke.mjs",
    "smoke:matrix": "node e2e/smoke.mjs --matrix"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@playgama/bridge": "^2.3.1",
    "@types/node": "^22.20.5",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
