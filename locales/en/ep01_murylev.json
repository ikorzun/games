  "ep01.mg_scene.title": "Apartment Search",
  "ep01.mg_scene.brief": "Find three items a person does not leave behind when going away for a long time. Tap suspicious spots.",
  "ep01.mg_scene.hs.glasses": "Glasses on the nightstand",
  "ep01.mg_scene.hs.pills": "Pills laid out by the hour",
